---
import { execSync } from 'node:child_process';

// CI passes the deployed commit (a pull request checks out a merge commit instead);
// fall back to the local HEAD
const sha = (process.env.COMMIT_SHA || execSync('git rev-parse HEAD', { encoding: 'utf8' })).trim().slice(0, 7);
---

<footer>
	&copy; krrrr38 All rights reserved. <a target="_blank" href="https://github.com/krrrr38/krrrr38.com">{sha}</a>
</footer>
<style>
	footer {
		padding: 25px;
		text-align: center;
	}
</style>

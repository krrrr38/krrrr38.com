{
  extends: ["config:base", "schedule:earlyMondays", "group:allNonMajor", "group:definitelyTyped"],
  automerge: true,
  platformAutomerge: true,
  labels: ["dependencies"],
  postUpdateOptions: ["pnpmDedupe"],
  prHourlyLimit: 0,
  prConcurrentLimit: 5,
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3am on sunday"],
  },
  vulnerabilityAlerts: {
    enabled: true,
    labels: ["security"],
  },
  packageRules: [
    {
      // `2.0.0-beta.sha-<hash>` builds cannot be ordered by version, so Renovate
      // may "update" to an older build. Update it manually until it ships a stable release.
      matchPackageNames: ["@cloudflare/vite-plugin"],
      enabled: false,
    },
    {
      // vite-plus, its catalog alias for vite and the vp CLI in mise.toml must move together
      groupName: "vite-plus",
      matchPackageNames: ["vite-plus", "@voidzero-dev/*", "voidzero-dev/vite-plus"],
    },
    {
      // Updated outside infra/, so no plan runs to gate the automerge.
      // Updates under infra/ are automerged only when the plan has no changes (terraform-plan.yaml).
      groupName: "terraform tooling",
      matchManagers: ["mise", "github-actions"],
      matchPackageNames: ["terraform", "hashicorp/terraform", "suzuki-shunsuke/tfaction"],
      automerge: false,
    },
    {
      groupName: "react",
      groupSlug: "react-patch",
      matchPackagePatterns: ["react*", "@types/react*", "@vitejs/plugin-react"],
      matchUpdateTypes: ["major"],
    },
  ],
}

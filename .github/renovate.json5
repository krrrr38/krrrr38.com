{
  extends: ["config:base", "schedule:earlyMondays", "group:allNonMajor", "group:definitelyTyped"],
  automerge: true,
  platformAutomerge: true,
  labels: ["dependencies"],
  postUpdateOptions: ["pnpmDedupe"],
  prHourlyLimit: 0,
  prConcurrentLimit: 5,
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3am on sunday"],
  },
  vulnerabilityAlerts: {
    enabled: true,
    labels: ["security"],
  },
  packageRules: [
    {
      // vite-plus, its catalog alias for vite and the vp CLI in mise.toml must move together
      groupName: "vite-plus",
      matchPackageNames: ["vite-plus", "@voidzero-dev/*", "voidzero-dev/vite-plus"],
    },
    {
      groupName: "astro",
      groupSlug: "astro-patch",
      matchPackagePatterns: ["astro", "@astrojs/*"],
      matchUpdateTypes: ["major"],
    },
    {
      groupName: "react",
      groupSlug: "react-patch",
      matchPackagePatterns: ["react*", "@types/react*"],
      matchUpdateTypes: ["major"],
    },
  ],
}
